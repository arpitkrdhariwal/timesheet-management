# Local development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Netlify: set NEXTAUTH_SECRET in Site settings → Environment variables.
# NEXTAUTH_URL is auto-set from Netlify URL on deploy (see src/lib/set-auth-env.js).
# For a custom domain, set NEXTAUTH_URL=https://your-domain.com
