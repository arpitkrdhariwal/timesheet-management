# Local development (port can differ — AUTH_TRUST_HOST is set automatically in dev)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Netlify: set NEXTAUTH_SECRET in Site settings → Environment variables (required).
# NEXTAUTH_URL and AUTH_TRUST_HOST are handled by src/lib/set-auth-env.js on deploy.
# For a custom domain, optionally set NEXTAUTH_URL=https://your-domain.com
